    "output": "1\t/** Sums sales per product: [{product, amount, at}] -> [{name, total}], largest first. */\n2\texport function totals(sales) {\n3\t  const byName = new Map();\n4\t  for (const s of sales) byName.set(s.product, (byName.get(s.product) ?? 0) + s.amount);\n5\t  return [...byName].map(([name, total]) => ({ name, total })).sort((a, b) => b.total - a.total);\n6\t}\n7\t\n8\t/** A plain-text table of the totals. */\n9\texport function formatReport(rows) {\n10\t  const width = Math.max(4, ...rows.map((r) => r.name.length));\n11\t  const lines = rows.map((r) => `${r.name.padEnd(width)}  ${r.total.toFixed(2).padStart(9)}`);\n12\t  return [`${'name'.padEnd(width)}  ${'total'.padStart(9)}`, ...lines].join('\\n');\n13\t}\n14\t",
